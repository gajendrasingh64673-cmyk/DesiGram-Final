{
  "installCommand": "cd artifacts/instagram-clone && npm install --legacy-peer-deps",
  "buildCommand": "cd artifacts/instagram-clone && npm run build",
  "outputDirectory": "artifacts/instagram-clone/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
