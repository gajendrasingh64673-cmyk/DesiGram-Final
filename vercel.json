{
  "installCommand": "npm install -g pnpm@10 && pnpm install --filter @workspace/instagram-clone... --no-frozen-lockfile --config.minimumReleaseAge=0 --network-concurrency=4 --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=60000",
  "buildCommand": "pnpm --filter @workspace/instagram-clone run build",
  "outputDirectory": "artifacts/instagram-clone/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
